# Seller Backend & MCP Server Configuration
PORT=8008
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Core SellerCek API / Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sellercek
