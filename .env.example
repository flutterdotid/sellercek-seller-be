# ==============================================================================
# Seller Backend & MCP Server Configuration
# Komunikasi data sepenuhnya melalui perantara Core API (sellercek-be),
# tanpa koneksi langsung ke PostgreSQL database.
# ==============================================================================
PORT=8008
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Core SellerCek API Gateway
SELLERCEK_CORE_API_URL=https://api.sellercek.com
SELLERCEK_CORE_TIMEOUT=30.0

# Kredensial Akses Seller (Opsional untuk testing lokal / STDIO agent default)
DEFAULT_SELLER_API_KEY=

# AI Provider (Opsional jika ingin direct embedding / inference fallback)
OPENAI_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
